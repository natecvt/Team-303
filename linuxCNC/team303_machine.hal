#loadusr -Wn vfd hy_vfd -n vfd -d /dev/ttyAMA0 -p none -r 19200  #if board has 485
#loadusr -Wn vfd hy_vfd -n vfd -d /dev/ttyUSB0 -p none -r 19200  #if using USBto485
#
#net spindle-vel-cmd-rpm-abs	vfd.speed-command
#net spindle-enable				vfd.spindle-on
#net spindle-cw					vfd.spindle-forward
#net spindle-ccw				vfd.spindle-reverse
#net spindle-at-speed			vfd.spindle-at-speed
#
#setp vfd.enable  1

##############################################
#                Laser Outputs
##############################################

#net laser-pwr spindle.0.speed-out-abs => pwmgen.1.value
#setp pwmgen.1.enable 1
#setp pwmgen.1.scale 100
#setp pwmgen.1.dither-pwm true
#net laser-pwm pwmgen.1.pwm => hal_gpio.GPIO18-out

##############################################
#                Stepper Outputs
##############################################

#Attention - Pin Numbers are now RPI GPIO pin Numbers

#if the pin or direction do not exist, change the 
#loadrt hal_gpio statement above to have the correct values


net xenable => hal_gpio.GPIO26-out
net xenable => not.0.in
net oenable not.0.out
net oenable => hal_gpio.GPIO24-out

net xstep	=> hal_gpio.GPIO9-out 
net xdir	=> hal_gpio.GPIO10-out
net ystep	=> hal_gpio.GPIO11-out
net ydir	=> hal_gpio.GPIO5-out
net zstep	=> hal_gpio.GPIO6-out
net zdir	=> hal_gpio.GPIO19-out
net ustep	=> hal_gpio.GPIO17-out
net udir	=> hal_gpio.GPIO23-out
net vstep	=> hal_gpio.GPIO27-out 
#net vdir	=> hal_gpio.GPIO24-out



##############################################
#               General Outputs
##############################################
#pin 18(GPIO24) controls the relay on the breakout board, so it can
#be used for the coolant if it isn't already used for 
#axis B or the spindle on/off
#
#net coolant iocontrol.0.coolant-flood => hal_pi_gpio.GPIO24-out
#

##############################################
#				Limit Inputs
##############################################
net min-home-x	<= hal_gpio.GPIO7-in
net min-home-y	<= hal_gpio.GPIO12-in
net min-home-z	<= hal_gpio.GPIO13-in
#net all-limit   <= hal_gpio.GPIO8-in
#pin 22 (GPIO25) is the eSTOP
net estop-ext <= hal_gpio.GPIO25-in-not

#net X-home hal_pi_gpio.pin-22-in => axis.0.home-sw-in axis.0.neg-lim-sw-in
#net Y-home hal_pi_gpio.pin-24-in => axis.1.home-sw-in axis.1.neg-lim-sw-in
#net Z-home hal_pi_gpio.pin-26-in => axis.2.home-sw-in axis.2.neg-lim-sw-in

# connect pin 32 to all three max limits
# net XYZ-max-lim hal_pi_gpio.pin-32-in => axis.0.pos-lim-sw-in 
# axis.1.pos-lim-sw-in axis.2.pos-lim-sw-in



##############################################
#				Stepper params
##############################################

# X AXIS
setp stepgen.0.position-scale [JOINT_0]SCALE
setp stepgen.0.steplen 1
setp stepgen.0.stepspace 0
setp stepgen.0.dirhold 60000
setp stepgen.0.dirsetup 60000
setp stepgen.0.maxaccel [JOINT_0]STEPGEN_MAXACCEL
net xpos-cmd joint.0.motor-pos-cmd => stepgen.0.position-cmd
net xpos-fb stepgen.0.position-fb => joint.0.motor-pos-fb
net xstep <= stepgen.0.step
net xdir <= stepgen.0.dir
net xenable joint.0.amp-enable-out => stepgen.0.enable
net min-home-x => joint.0.home-sw-in
net all-limit => joint.0.neg-lim-sw-in
net all-limit => joint.0.pos-lim-sw-in

# Y AXIS
setp stepgen.1.position-scale [JOINT_1]SCALE
setp stepgen.1.steplen 1
setp stepgen.1.stepspace 0
setp stepgen.1.dirhold 60000
setp stepgen.1.dirsetup 60000
setp stepgen.1.maxaccel [JOINT_1]STEPGEN_MAXACCEL
net ypos-cmd joint.1.motor-pos-cmd => stepgen.1.position-cmd
net ypos-fb stepgen.1.position-fb => joint.1.motor-pos-fb
net ystep <= stepgen.1.step
net ydir <= stepgen.1.dir
net yenable joint.1.amp-enable-out => stepgen.1.enable
net min-home-y => joint.1.home-sw-in
net all-limit => joint.1.neg-lim-sw-in
net all-limit => joint.1.pos-lim-sw-in

# Z AXIS
setp stepgen.2.position-scale [JOINT_2]SCALE
setp stepgen.2.steplen 1
setp stepgen.2.stepspace 0
setp stepgen.2.dirhold 60000
setp stepgen.2.dirsetup 60000
setp stepgen.2.maxaccel [JOINT_2]STEPGEN_MAXACCEL
net zpos-cmd joint.2.motor-pos-cmd => stepgen.2.position-cmd
net zpos-fb stepgen.2.position-fb => joint.2.motor-pos-fb
net zstep <= stepgen.2.step
net zdir <= stepgen.2.dir
net zenable joint.2.amp-enable-out => stepgen.2.enable
net min-home-z => joint.2.home-sw-in

net all-limit => joint.2.neg-lim-sw-in
net all-limit => joint.2.pos-lim-sw-in

# U AXIS
setp stepgen.3.position-scale [JOINT_3]SCALE
setp stepgen.3.steplen 1
setp stepgen.3.stepspace 0
setp stepgen.3.dirhold 60000
setp stepgen.3.dirsetup 60000
setp stepgen.3.maxaccel [JOINT_3]STEPGEN_MAXACCEL
net upos-cmd joint.3.motor-pos-cmd => stepgen.3.position-cmd
net upos-fb stepgen.3.position-fb => joint.3.motor-pos-fb
net ustep <= stepgen.3.step
net udir <= stepgen.3.dir
net uenable joint.3.amp-enable-out => stepgen.3.enable
net min-home-u => joint.3.home-sw-in

net all-limit => joint.3.neg-lim-sw-in
net all-limit => joint.3.pos-lim-sw-in

# V AXIS
setp stepgen.4.position-scale [JOINT_4]SCALE
setp stepgen.4.steplen 1
setp stepgen.4.stepspace 0
setp stepgen.4.dirhold 60000
setp stepgen.4.dirsetup 60000
setp stepgen.4.maxaccel [JOINT_4]STEPGEN_MAXACCEL
net vpos-cmd joint.4.motor-pos-cmd => stepgen.4.position-cmd
net vpos-fb stepgen.4.position-fb => joint.4.motor-pos-fb
net vstep <= stepgen.4.step
# net vdir <= stepgen.4.dir
net venable joint.4.amp-enable-out => stepgen.4.enable
net min-home-v => joint.4.home-sw-in

net all-limit => joint.4.neg-lim-sw-in
net all-limit => joint.4.pos-lim-sw-in


net estop-out <= iocontrol.0.user-enable-out
#customer note: use estop-ext instead of estop-out in the next statement
net estop-ext => iocontrol.0.emc-enable-in
#net estop-out => iocontrol.0.emc-enable-in

loadusr -W hal_manualtoolchange
net tool-change iocontrol.0.tool-change => hal_manualtoolchange.change
net tool-changed iocontrol.0.tool-changed <= hal_manualtoolchange.changed
net tool-number iocontrol.0.tool-prep-number => hal_manualtoolchange.number
net tool-prepare-loopback iocontrol.0.tool-prepare => iocontrol.0.tool-prepared


